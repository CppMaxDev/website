import ReferenceLayout from '../../components/ReferenceLayout.astro';

const contents = [
  { href: '#offline', label: 'The iOS constraint' },
  { href: '#standard-files', label: 'Project input' },
  { href: '#compilation', label: 'Compilation' },
  { href: '#signing', label: 'Build signing' },
  { href: '#interpreter', label: 'AArch64 interpreter' },
  { href: '#linux-layer', label: 'Virtual Linux layer' },
  { href: '#runtime-limits', label: 'Current limits' },
];
---

<ReferenceLayout
  pageTitle="How cppMax runs C++ on iOS"
  metaDescription="A technical overview of the compiler, ELF signing, interpreter, and virtual Linux layer inside cppMax."
  heading="How cppMax runs C++ on iOS."
  introduction="A technical overview of the path from source files to an interpreted arm64 program."
  contents={contents}
>
  <p class="temporary-note">Temporary technical copy. The final version will document the implementation in more detail.</p>

  <section id="offline">
    <p class="section-label">The iOS constraint</p>
    <h2>Compiled code cannot be loaded as a new iOS app.</h2>
    <p>Clang can produce native instructions on an iPhone or iPad, but iOS does not let cppMax load that newly compiled output as executable app code. cppMax keeps the compiler output and changes the way the program runs.</p>
    <p>The program stays inside cppMax. A custom runtime reads its instructions and performs their effects without asking iOS to execute the ELF directly.</p>
  </section>

  <section id="standard-files">
    <p class="section-label">Project input</p>
    <h2>The pipeline starts with normal project files.</h2>
    <p>Source and header files remain ordinary files. CMake can describe the build, and Git can track the project. cppMax does not require a proprietary source format.</p>
    <div class="technical-flow" aria-label="Example project inputs">
      <span>main.cpp</span><span>parser.hpp</span><span>CMakeLists.txt</span>
    </div>
  </section>

  <section id="compilation">
    <p class="section-label">Compilation</p>
    <h2>Clang and LLD produce an arm64 ELF.</h2>
    <p>The bundled toolchain runs on the device. Clang compiles the C++ translation units, and LLD links the objects into an ELF for the arm64 architecture.</p>
    <div class="technical-flow" aria-label="Compilation stages">
      <span>C++ source</span><span>Clang + LLD</span><span>arm64 ELF</span>
    </div>
  </section>

  <section id="signing">
    <p class="section-label">Build signing</p>
    <h2>The signature belongs to one exact build.</h2>
    <p>cppMax records the ELF's SHA-256 hash during signing. A change to the executable produces a different hash, so the rebuilt file needs a new signature.</p>
    <p>An unchanged signed ELF can run again because its bytes and hash have not changed.</p>
  </section>

  <section id="interpreter">
    <p class="section-label">AArch64 interpreter</p>
    <h2>The runtime decodes instructions instead of loading the ELF.</h2>
    <p>The interpreter reads an AArch64 instruction, decodes it, updates its virtual machine state, and moves to the next instruction. iOS runs cppMax itself. cppMax runs the program model inside the app.</p>
    <div class="technical-flow" aria-label="Interpretation stages">
      <span>Fetch instruction</span><span>Decode operation</span><span>Update state</span>
    </div>
  </section>

  <section id="linux-layer">
    <p class="section-label">Virtual Linux layer</p>
    <h2>Supported Linux calls are mapped to iOS operations.</h2>
    <p>C++ programs need more than CPU instructions. They also ask the operating system to open files, read bytes, write output, and perform other work. The virtual Linux layer handles the supported requests and translates them into operations available to cppMax on iOS.</p>
    <p>The current beta covers roughly 50 system calls. That focused set supports console programs and local file work.</p>
  </section>

  <section id="runtime-limits">
    <p class="section-label">Current limits</p>
    <h2>The beta runtime does not cover all Linux software.</h2>
    <ul>
      <li>The virtual Linux layer implements a limited system-call set.</li>
      <li>An unsupported instruction stops the program cleanly.</li>
      <li>OpenGL translation to Metal is planned for v1 and is not part of the beta.</li>
      <li>Projects tied to platform-specific libraries may need changes.</li>
    </ul>
  </section>
</ReferenceLayout>
