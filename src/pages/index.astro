---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="cppMax, a fully offline C++ IDE for iOS"
  description="cppMax is a fully offline C++ IDE for iPhone and iPad. The current app is in beta."
>
  <section class="home-hero">
    <div class="hero-copy">
      <h1>CppMax</h1>
      <p class="hero-subtitle">Fully offline C++ IDE on iOS</p>
      <p class="beta-note">*Currently in beta: <a href="/features/">feature list</a></p>
    </div>

    <figure class="ipad-preview">
      <img src="/images/first-ipad.png" alt="Illustrative iPad placeholder for a future cppMax screen recording" />
      <figcaption>*Illustrative placeholder. Final version will use a real screen recording.</figcaption>
    </figure>
  </section>

  <section class="home-body" aria-labelledby="feature-heading">
    <div class="feature-shell">
      <h2 id="feature-heading">Built for C++ work on iOS</h2>
      <div class="feature-cards">
        <a class="feature-card" href="/how-it-works/#offline">
          <span class="placeholder-icon" aria-hidden="true">01</span>
          <h3>Works Offline</h3>
          <p>Edit, compile, and run local projects without sending them to a remote build machine.</p>
        </a>
        <a class="feature-card" href="/how-it-works/#compilation">
          <span class="placeholder-icon" aria-hidden="true">02</span>
          <h3>Real Compilation Pipeline</h3>
          <p>Clang and LLD produce an arm64 ELF on the device.</p>
        </a>
        <a class="feature-card" href="/features/#project-work">
          <span class="placeholder-icon" aria-hidden="true">03</span>
          <h3>Do Real Work</h3>
          <p>Work with project files, Git repositories, CMake builds, and console programs.</p>
        </a>
        <a class="feature-card" href="/features/#development-tools">
          <span class="placeholder-icon" aria-hidden="true">04</span>
          <h3>Professional Development Tools</h3>
          <p>Use the beta editor, static analysis, breakpoints, and console input and output.</p>
        </a>
        <a class="feature-card" href="/how-it-works/#standard-files">
          <span class="placeholder-icon" aria-hidden="true">05</span>
          <h3>No Proprietary File Format</h3>
          <p>Projects use normal source files, CMake configuration, Git, and standard arm64 ELF output.</p>
        </a>
        <a class="feature-card" href="/changelog/">
          <span class="placeholder-icon" aria-hidden="true">06</span>
          <h3>Actively Being Developed</h3>
          <p>Follow changes to the current beta as new builds are prepared.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const preview = document.querySelector<HTMLElement>('.ipad-preview');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let frame = 0;

  const updatePreview = () => {
    frame = 0;
    if (!preview || reducedMotion.matches) return;
    const progress = Math.min(Math.max(window.scrollY / 520, 0), 1);
    preview.style.setProperty('--scroll-progress', progress.toString());
  };

  const requestPreviewUpdate = () => {
    if (!frame) frame = window.requestAnimationFrame(updatePreview);
  };

  updatePreview();
  window.addEventListener('scroll', requestPreviewUpdate, { passive: true });
</script>

<style>
  .home-hero {
    position: relative;
    min-height: calc(100svh - 72px);
    padding: clamp(92px, 12vw, 150px) 24px 0;
    overflow: visible;
    background-color: #f8fbff;
    background-image: url('/images/background-top.jpg');
    background-repeat: no-repeat;
    background-position: center top;
    background-size: cover;
    text-align: center;
  }

  .hero-copy { position: relative; z-index: 1; }
  .hero-copy h1 {
    max-width: none;
    margin: 0;
    color: #08090b;
    font-size: clamp(4.5rem, 10vw, 8rem);
    font-weight: 700;
    line-height: .95;
    letter-spacing: -.07em;
  }
  .hero-subtitle {
    margin: 20px 0 0;
    color: #202124;
    font-size: clamp(1.35rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.035em;
  }
  .beta-note {
    margin: 14px 0 0;
    color: #4f5358;
    font-size: clamp(.95rem, 1.6vw, 1.15rem);
    line-height: 1.4;
  }
  .beta-note a {
    color: #0066cc;
    text-underline-offset: 3px;
  }
  .ipad-preview {
    --scroll-progress: 0;
    position: absolute;
    z-index: 3;
    top: 52%;
    left: 50%;
    width: min(940px, 88vw);
    margin: 0;
    filter: drop-shadow(0 calc(18px + 20px * var(--scroll-progress)) calc(22px + 24px * var(--scroll-progress)) rgba(0, 0, 0, calc(.2 + .2 * var(--scroll-progress))));
    transform: translateX(-50%) scale(calc(1 + .04 * var(--scroll-progress)));
    transform-origin: center top;
    will-change: filter, transform;
  }
  .ipad-preview img {
    width: 100%;
  }
  .ipad-preview figcaption {
    margin-top: 10px;
    color: #53565a;
    font-size: .76rem;
    line-height: 1.4;
  }
  .home-body {
    position: relative;
    z-index: 1;
    min-height: 90vh;
    padding: clamp(500px, 62vw, 690px) 24px 120px;
    color: #f5f5f7;
    background: #242526;
  }
  .feature-shell { width: min(1180px, 100%); margin-inline: auto; }
  .feature-shell > h2 {
    max-width: 760px;
    margin-bottom: 48px;
    font-size: clamp(2.5rem, 5vw, 4.8rem);
  }
  .feature-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .feature-card {
    min-height: 270px;
    padding: 28px;
    border: 1px solid #454649;
    border-radius: 22px;
    color: #f5f5f7;
    background: #2d2e30;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .feature-card:hover {
    border-color: #727478;
    background: #343537;
    transform: translateY(-4px);
  }
  .placeholder-icon {
    display: grid;
    width: 46px;
    height: 46px;
    margin-bottom: 48px;
    place-items: center;
    border: 1px solid #66686c;
    border-radius: 12px;
    color: #aeb0b4;
    font: 600 .7rem/1 ui-monospace, monospace;
  }
  .feature-card h3 { margin-bottom: 11px; font-size: 1.35rem; letter-spacing: -.025em; }
  .feature-card p { margin: 0; color: #b7b8bc; font-size: .94rem; line-height: 1.55; }

  @media (max-width: 700px) {
    .home-hero { min-height: calc(100svh - 72px); padding-top: 82px; }
    .ipad-preview { top: 57%; width: min(780px, 112vw); }
    .ipad-preview figcaption { padding-inline: 32px; }
    .home-body { padding-top: clamp(400px, 96vw, 560px); }
    .feature-cards { grid-template-columns: 1fr; }
  }

  @media (min-width: 701px) and (max-width: 980px) {
    .feature-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ipad-preview { filter: drop-shadow(0 24px 28px rgba(0, 0, 0, .28)); transform: translateX(-50%); }
    .feature-card { transition: none; }
  }
</style>
