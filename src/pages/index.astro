---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="cppMax, a fully offline C++ IDE for iOS"
  description="cppMax is a fully offline C++ IDE for iPhone and iPad. The current app is in beta."
>
  <div class="home-scroll-scene">
    <div class="keyboard-backdrop" aria-hidden="true">
      <div class="keyboard-stage">
        <div class="keyboard-devices">
          <img class="keyboard-ipad" src="/images/ipad-keyboard.png" alt="" />
          <img class="keyboard-phone" src="/images/phone-keyboard.png" alt="" />
          <span class="placeholder-label">Illustrative keyboard connection placeholder</span>
        </div>
      </div>
    </div>

    <section class="home-hero">
      <div class="hero-copy">
        <h1>CppMax</h1>
        <p class="hero-subtitle">Fully offline C++ IDE on iOS</p>
        <p class="beta-note">*Currently in beta: <a href="/features/">feature list</a></p>
      </div>

      <figure class="ipad-preview">
        <img src="/images/first-ipad.png" alt="Illustrative iPad placeholder for a future cppMax screen recording" />
        <figcaption>*Illustrative placeholder. Final version will use a real screen recording.</figcaption>
      </figure>
    </section>

    <section class="home-body" aria-labelledby="feature-heading">
      <div class="feature-shell">
        <!--<h2 id="feature-heading">Built for C++ work on iOS</h2>-->
        <div class="feature-cards">
          <a class="feature-card" href="/how-it-works/#offline">
            <span class="placeholder-icon" aria-hidden="true">01</span>
            <h3>Works offline</h3>
            <p>Edit, compile, and run local projects completcompletely on device. <b>YOUR FILES NEVER HAVE TO LEAVE YOUR DEVICE!</b></p>
          </a>
          <a class="feature-card" href="/how-it-works/#compilation">
            <span class="placeholder-icon" aria-hidden="true">02</span>
            <h3>Real compilation pipeline</h3>
            <p>Clang and LLD produce a <u><b>REAL</b> arm64 <b>ELF</b></u> on the device. Just like they would on any PC.</p>
          </a>
          <a class="feature-card" href="/features/#project-work">
            <span class="placeholder-icon" aria-hidden="true">03</span>
            <h3>Do real work</h3>
            <p>Work on YOUR REAL FILE SYSTEM, programaticaly analyze real files, create new ones, all packaged behind a linux like wrapper. <br> * linux wrapper does not <u>yet</u> support all syscalls. </p>
          </a>
          <a class="feature-card" href="/features/#development-tools">
            <span class="placeholder-icon" aria-hidden="true">04</span>
            <h3>Professional development tools</h3>
            <p>FULL GIT and CMAKE support! Optimized to work with GIGANTIC FILES in COMPLEX PROJECTS</p>
          </a>
          <a class="feature-card" href="/privacy/">
            <span class="placeholder-icon" aria-hidden="true">05</span>
            <h3>Privacy First</h3>
            <p>NO ACCOUNT at all, and Everything is LOCAL! No cloud server, no file sending, no sketchy privacy policy. YOU controll YOUR files</p>
          </a>
          <a class="feature-card" href="/changelog/">
            <span class="placeholder-icon" aria-hidden="true">06</span>
            <h3>Actively being developed</h3>
            <p>I'm a single devdeveloper, actively working on this project. Have a look at the change logs.</p>
          </a>
        </div>
      </div>

      <div class="keyboard-feature-reveal" aria-hidden="true"></div>
    </section>
  </div>
</Layout>

<script>
  const preview = document.querySelector<HTMLElement>('.ipad-preview');
  const cards = document.querySelector<HTMLElement>('.feature-shell');
  const keyboardDevices = document.querySelector<HTMLElement>('.keyboard-devices');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let frame = 0;

  const updatePageEffects = () => {
    frame = 0;

    if (preview && !reducedMotion.matches) {
      const progress = Math.min(Math.max(window.scrollY / 520, 0), 1);
      preview.style.setProperty('--preview-scale', (1 + progress * .04).toString());
      preview.style.setProperty('--shadow-y', `${18 + progress * 20}px`);
      preview.style.setProperty('--shadow-blur', `${22 + progress * 24}px`);
      preview.style.setProperty('--shadow-alpha', (.2 + progress * .2).toString());
    }

    if (cards && keyboardDevices) {
      const cardBounds = cards.getBoundingClientRect();
      const blurStart = window.innerHeight * .86;
      const blurEnd = 72;
      const blurDistance = Math.max(blurStart + cardBounds.height - blurEnd, 1);
      const progress = Math.min(Math.max((blurStart - cardBounds.top) / blurDistance, 0), 1);
      const maximumBlur = window.innerWidth <= 700 ? 32 : 48;
      const blur = maximumBlur * Math.pow(1 - progress, .68);
      keyboardDevices.style.setProperty('--device-blur', `${blur.toFixed(2)}px`);
    }
  };

  const requestPageUpdate = () => {
    if (!frame) frame = window.requestAnimationFrame(updatePageEffects);
  };

  updatePageEffects();
  window.addEventListener('scroll', requestPageUpdate, { passive: true });
  window.addEventListener('resize', requestPageUpdate, { passive: true });
</script>

<style>
  :global(html),
  :global(body) { overflow-x: clip; }

  .home-scroll-scene {
    position: relative;
    background: #202123;
    isolation: isolate;
  }
  .home-hero {
    position: relative;
    z-index: 2;
    min-height: calc(100svh - 72px);
    padding: clamp(92px, 12vw, 150px) 24px 0;
    overflow: visible;
    background-color: #f8fbff;
    background-image: url('/images/background-top.jpg');
    background-repeat: no-repeat;
    background-position: center top;
    background-size: cover;
    text-align: center;
  }

  .hero-copy { position: relative; z-index: 1; }
  .hero-copy h1 {
    max-width: none;
    margin: 0;
    color: #08090b;
    font-size: clamp(4.5rem, 10vw, 8rem);
    font-weight: 700;
    line-height: .95;
    letter-spacing: -.07em;
  }
  .hero-subtitle {
    margin: 20px 0 0;
    color: #202124;
    font-size: clamp(1.35rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.035em;
  }
  .beta-note {
    margin: 14px 0 0;
    color: #4f5358;
    font-size: clamp(.95rem, 1.6vw, 1.15rem);
    line-height: 1.4;
  }
  .beta-note a {
    color: #0066cc;
    text-underline-offset: 3px;
  }
  .ipad-preview {
    --preview-scale: 1;
    --shadow-y: 18px;
    --shadow-blur: 22px;
    --shadow-alpha: .2;
    position: absolute;
    z-index: 3;
    top: 52%;
    left: 50%;
    width: min(940px, 88vw);
    margin: 0;
    filter: drop-shadow(0 var(--shadow-y) var(--shadow-blur) rgba(0, 0, 0, var(--shadow-alpha)));
    transform: translateX(-50%) scale(var(--preview-scale));
    transform-origin: center top;
    will-change: filter, transform;
  }
  .ipad-preview img {
    width: 100%;
  }
  .ipad-preview figcaption {
    margin-top: 10px;
    color: #53565a;
    font-size: .76rem;
    line-height: 1.4;
  }
  .home-body {
    position: relative;
    z-index: 1;
    min-height: 90vh;
    padding: clamp(500px, 62vw, 690px) 24px 120px;
    color: #f5f5f7;
    background: transparent;
    isolation: isolate;
  }
  .keyboard-backdrop {
    position: absolute;
    z-index: -2;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }
  .keyboard-stage {
    position: sticky;
    top: 72px;
    height: calc(100svh - 72px);
    min-height: 620px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 42%, rgba(90, 72, 108, .24), transparent 48%),
      #202123;
  }
  .keyboard-devices {
    --device-blur: 48px;
    position: relative;
    width: min(1180px, 96vw);
    height: 100%;
    margin-inline: auto;
  }
  .keyboard-ipad,
  .keyboard-phone {
    position: absolute;
    max-width: none;
    filter: blur(var(--device-blur)) drop-shadow(0 30px 50px rgba(0, 0, 0, .56));
    will-change: filter;
  }
  .keyboard-ipad {
    top: 5%;
    left: 50%;
    width: min(1040px, 86vw);
    transform: translateX(-50%);
  }
  .keyboard-phone {
    z-index: 1;
    left: 50%;
    bottom: 2%;
    width: min(690px, 58vw);
    transform: translateX(-50%);
  }
  .placeholder-label {
    position: absolute;
    z-index: 2;
    right: 18px;
    bottom: 18px;
    padding: 7px 10px;
    border: 1px solid rgba(255, 255, 255, .22);
    border-radius: 999px;
    color: rgba(255, 255, 255, .62);
    background: rgba(20, 20, 22, .42);
    font-size: .7rem;
    line-height: 1;
    backdrop-filter: blur(10px);
  }
  .feature-shell {
    position: relative;
    width: min(1180px, 100%);
    margin-inline: auto;
  }
  .keyboard-feature-reveal {
    min-height: calc(100svh - 72px);
  }
  .feature-shell > h2 {
    max-width: 760px;
    margin-bottom: 48px;
    font-size: clamp(2.5rem, 5vw, 4.8rem);
  }
  .feature-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .feature-card {
    position: relative;
    min-height: 270px;
    padding: 28px;
    border: 1px solid #454649;
    border-radius: 22px;
    color: #f5f5f7;
    background: rgba(45, 46, 48, .9);
    box-shadow: 0 18px 46px rgba(0, 0, 0, .16);
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .feature-card:hover {
    border-color: #727478;
    background: #343537;
    transform: translateY(-4px);
  }
  .placeholder-icon {
    display: grid;
    width: 46px;
    height: 46px;
    margin-bottom: 48px;
    place-items: center;
    border: 1px solid #66686c;
    border-radius: 12px;
    color: #aeb0b4;
    font: 600 .7rem/1 ui-monospace, monospace;
  }
  .feature-card h3 { margin-bottom: 11px; font-size: 1.35rem; letter-spacing: -.025em; }
  .feature-card p { margin: 0; color: #b7b8bc; font-size: .94rem; line-height: 1.55; }

  @media (max-width: 700px) {
    .home-hero { min-height: calc(100svh - 72px); padding-top: 82px; }
    .ipad-preview { top: 57%; width: min(780px, 112vw); }
    .ipad-preview figcaption { padding-inline: 32px; }
    .home-body { padding-top: clamp(400px, 96vw, 560px); }
    .keyboard-stage { min-height: 520px; }
    .keyboard-ipad { top: 10%; width: 118vw; }
    .keyboard-phone { left: 50%; bottom: 8%; width: 96vw; transform: translateX(-50%); }
    .placeholder-label { right: 12px; bottom: 12px; font-size: .62rem; }
    .feature-cards { grid-template-columns: 1fr; }
  }

  @media (min-width: 701px) and (max-width: 980px) {
    .feature-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ipad-preview { filter: drop-shadow(0 24px 28px rgba(0, 0, 0, .28)); transform: translateX(-50%); }
    .feature-card { transition: none; }
  }
</style>
