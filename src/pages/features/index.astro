---
import Layout from '../../layouts/Layout.astro';

const categories = [
  {
    id: 'editor',
    label: 'Editor',
    features: [
      { name: 'Multiple file tabs', implemented: true, description: 'Open several source files and move between them in tabs.' },
      { name: 'Project file browser', implemented: true, description: 'Browse and manage the files in a local project.' },
      { name: 'C++ syntax highlighting', implemented: true, description: 'Basic syntax colors make source files easier to scan.' },
      { name: 'Static analysis', implemented: true, description: 'Basic diagnostics catch common issues before a build.' },
      { name: 'Breakpoints', implemented: true, description: 'Pause a running program at basic breakpoints.' },
      { name: 'Console input and output', implemented: true, description: 'Read and write through std::iostream.' },
      { name: 'Advanced static analysis', implemented: false, description: 'Deeper analysis is planned for v1.' },
      { name: 'Advanced debugging', implemented: false, description: 'The beta debugger covers basic breakpoints only.' },
      { name: 'Phone keyboard pairing', implemented: false, description: 'Phone-as-keyboard pairing is planned for v1.' },
      { name: 'Interface customization', implemented: false, description: 'More interface customization is planned for v1.' },
    ],
  },
  {
  id: 'git',
  label: 'Git',
  features: [
    {
      name: 'Initialize repositories',
      implemented: true,
      description: 'Find an existing Git repository or initialize one inside the selected project folder.',
    },
    {
      name: 'Clone repositories',
      implemented: true,
      description: 'Clone over HTTPS or from a local path. Clone progress can be cancelled.',
    },
    {
      name: 'View file status',
      implemented: true,
      description: 'See staged, unstaged, untracked, ignored, and renamed files in the current worktree.',
    },
    {
      name: 'Stage and unstage changes',
      implemented: true,
      description: 'Add files to the index or remove staged changes without changing the working file.',
    },
    {
      name: 'Restore files',
      implemented: true,
      description: 'Restore tracked files and remove explicitly selected untracked files.',
    },
    {
      name: 'View diffs',
      implemented: true,
      description: 'Open staged, unstaged, and commit diffs with old and new lines aligned side by side.',
    },
    {
      name: 'View commit history',
      implemented: true,
      description: 'Browse commits and inspect the files and metadata stored in each commit.',
    },
    {
      name: 'Amend commits',
      implemented: true,
      description: 'Replace the latest commit with updated changes or commit metadata.',
    },
    {
      name: 'Blame',
      implemented: true,
      description: 'See which commit last changed each line in a file.',
    },
    {
      name: 'Reflog',
      implemented: true,
      description: 'Inspect recent changes to local Git references.',
    },
    {
      name: 'Manage branches',
      implemented: true,
      description: 'List, create, checkout, rename, and safely delete local and remote-tracking branches.',
    },
    {
      name: 'Detached checkout',
      implemented: true,
      description: 'Checkout a commit or revision without creating or switching to a branch.',
    },
    {
      name: 'Set branch upstream',
      implemented: true,
      description: 'Set or remove the upstream branch used for pull, push, and ahead or behind counts.',
    },
    {
      name: 'Merge branches',
      implemented: true,
      description: 'Merge another revision into the current branch and continue or abort after conflicts.',
    },
    {
      name: 'Rebase branches',
      implemented: true,
      description: 'Rebase commits onto another revision and continue or abort after conflicts.',
    },
    {
      name: 'Manage tags',
      implemented: true,
      description: 'Create, list, checkout, and delete lightweight or annotated tags.',
    },
    {
      name: 'Cherry-pick commits',
      implemented: true,
      description: 'Apply a selected commit onto the current branch.',
    },
    {
      name: 'Revert commits',
      implemented: true,
      description: 'Create changes that undo a selected commit.',
    },
    {
      name: 'Reset revisions',
      implemented: true,
      description: 'Reset with soft, mixed, or hard mode to a selected revision.',
    },
    {
      name: 'Apply patches',
      implemented: true,
      description: 'Apply a Git patch to the current repository.',
    },
    {
      name: 'Stash changes',
      implemented: true,
      description: 'Save, apply, pop, and drop stashes. Stashes can include untracked files and staged state.',
    },
    {
      name: 'Resolve conflicts',
      implemented: true,
      description: 'Resolve index conflicts with ours, theirs, or the current working file before continuing.',
    },
    {
      name: 'Resume interrupted operations',
      implemented: true,
      description: 'Merge, rebase, cherry-pick, and revert state survives an app relaunch.',
    },
    {
      name: 'Manage remotes',
      implemented: true,
      description: 'Add, edit, rename, and remove remotes. Fetch and push URLs can differ.',
    },
    {
      name: 'Fetch',
      implemented: true,
      description: 'Download remote refs and objects without changing the current branch.',
    },
    {
      name: 'Prune remote branches',
      implemented: true,
      description: 'Remove remote-tracking references that no longer exist on the remote.',
    },
    {
      name: 'Pull',
      implemented: true,
      description: 'Fast-forward the current branch from its configured upstream.',
    },
    {
      name: 'Push',
      implemented: true,
      description: 'Push branches, tags, deletions, or arbitrary refspecs to a remote.',
    },
    {
      name: 'Ahead and behind counts',
      implemented: true,
      description: 'See how many commits a branch is ahead of or behind its upstream.',
    },
    {
      name: 'Update submodules',
      implemented: true,
      description: 'Find declared submodules and initialize or update them with authentication when needed.',
    },
    {
      name: 'Keychain credentials',
      implemented: true,
      description: 'Store Git credentials in the iOS Keychain instead of the project file.',
    },
    {
      name: 'SSH remotes',
      implemented: false,
      description: 'Network remotes use HTTPS. The embedded Git library does not include an SSH implementation.',
    },
    {
      name: 'Git hooks',
      implemented: false,
      description: 'cppMax does not run repository hooks because they execute repository-provided programs.',
    },
    {
      name: 'External Git helpers',
      implemented: false,
      description: 'External credential helpers, diff drivers, merge drivers, shell transports, and executable filters cannot run inside the app sandbox.',
    },
    {
      name: 'Multiple worktrees',
      implemented: false,
      description: 'Each cppMax project currently manages one Git worktree.',
    },
    {
      name: 'Signed commits and tags',
      implemented: false,
      description: 'cppMax does not currently create OpenPGP-signed commits or tags.',
    },
  ],
},
  {
    id: 'cmake',
    label: 'CMake',
    features: [
      { name: 'Most CMake projects', implemented: true, description: 'The beta configures most common CMake project setups.' },
      { name: 'Platform-specific dependencies', implemented: false, description: 'Projects tied to another platform may need changes.' },
      { name: 'Unusual build scripts', implemented: false, description: 'Unusual build scripts may need changes before they work.' },
    ],
  },
  {
    id: 'interpreter',
    label: 'Interpreter',
    features: [
      { name: 'On-device compilation', implemented: true, description: 'LLVM, Clang, and LLD run on the device.' },
      { name: 'arm64 ELF output', implemented: true, description: 'The compilation pipeline produces a standard arm64 ELF.' },
      { name: 'AArch64 execution', implemented: true, description: 'The custom interpreter executes the ELF without loading it as native iOS code.' },
      { name: 'Automatic ELF signing', implemented: true, description: 'cppMax signs a build against the ELF SHA-256 hash.' },
      { name: 'Repeat signed runs', implemented: true, description: 'An unchanged signed ELF can run again without another signature.' },
      { name: 'Virtual Linux file access', implemented: true, description: 'Supported system calls let programs read and create real files.' },
      { name: 'Roughly 50 system calls', implemented: true, description: 'The beta maps a focused set of Linux calls to iOS operations.' },
      { name: 'Clean unsupported-instruction stop', implemented: true, description: 'An unsupported instruction stops the program instead of crashing the project.' },
      { name: 'Broad Linux compatibility', implemented: false, description: 'The current virtual Linux layer supports a limited call set.' },
      { name: 'OpenGL translation', implemented: false, description: 'OpenGL translation to Metal is planned for v1.' },
    ],
  },
].map((category) => {
  const implemented = category.features.filter((feature) => feature.implemented).length;
  const unimplemented = category.features.length - implemented;
  const tone = implemented === 0 ? 'red' : unimplemented === 0 ? 'green' : 'yellow';
  return { ...category, implemented, unimplemented, tone };
});
---

<Layout title="What works | cppMax" description="An exact checklist of tools and limits in the current cppMax beta.">
  <header class="feature-hero">
    <div class="shell">
      <h1>What you can build with today.</h1>
      <p>The current beta checklist. Planned v1 work is marked separately.</p>
    </div>
  </header>

  <section class="feature-browser" aria-label="cppMax beta feature list">
    <div class="browser-shell">
      <aside class="feature-sidebar">
        <label class="search-field">
          <span class="sr-only">Search features</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
          <input type="search" placeholder="Search features" autocomplete="off" data-feature-search />
        </label>

        <nav class="category-list" aria-label="Feature categories">
          <button class="category-button active" type="button" data-category-button data-category="all" aria-pressed="true">
            <span>All features</span>
            <span class="category-total">{categories.reduce((total, category) => total + category.features.length, 0)}</span>
          </button>
          {categories.map((category) => (
            <button class={`category-button ${category.tone}`} type="button" data-category-button data-category={category.id} aria-pressed="false">
              <span>{category.label}</span>
              <span class="category-counts" aria-label={`${category.implemented} implemented and ${category.unimplemented} unimplemented`}>
                <span>✅ {category.implemented}</span><span>❌ {category.unimplemented}</span>
              </span>
            </button>
          ))}
        </nav>
      </aside>

      <div class="feature-results">
        <div class="results-heading">
          <h2 data-results-title>All features</h2>
          <span data-results-count>{categories.reduce((total, category) => total + category.features.length, 0)} items</span>
        </div>
        <div class="feature-grid" data-feature-grid>
          {categories.flatMap((category) => category.features.map((feature) => (
            <article
              class={`feature-card ${feature.implemented ? 'implemented' : 'unimplemented'}`}
              data-feature-card
              data-category={category.id}
              data-search={`${feature.name} ${feature.description}`.toLowerCase()}
            >
              <div class="card-heading">
                <h3>{feature.name}</h3>
                <span class="feature-status" aria-label={feature.implemented ? 'Implemented' : 'Not implemented'}>{feature.implemented ? '✅' : '❌'}</span>
              </div>
              <p>{feature.description}</p>
              <span class="category-label">{category.label}</span>
            </article>
          ))) }

          {categories.map((category) => (
            <button
              class="feature-card category-match-card"
              type="button"
              data-category-match-card={category.id}
              data-category-label={category.label}
              hidden
            >
              <div class="card-heading">
                <h3 data-category-match-title></h3>
              </div>
              <p data-category-match-description></p>
              <span class="category-label">{category.label}</span>
            </button>
          ))}
        </div>
        <p class="no-results" data-no-results hidden>No features match that search.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const browser = document.querySelector<HTMLElement>('[data-feature-grid]')?.closest('.feature-browser');
  const search = browser?.querySelector<HTMLInputElement>('[data-feature-search]');
  const buttons = [...(browser?.querySelectorAll<HTMLButtonElement>('[data-category-button]') ?? [])];
  const cards = [...(browser?.querySelectorAll<HTMLElement>('[data-feature-card]') ?? [])];
  const matchCards = [...(browser?.querySelectorAll<HTMLButtonElement>('[data-category-match-card]') ?? [])];
  const title = browser?.querySelector<HTMLElement>('[data-results-title]');
  const count = browser?.querySelector<HTMLElement>('[data-results-count]');
  const noResults = browser?.querySelector<HTMLElement>('[data-no-results]');
  let selectedCategory = buttons.find((button) => button.classList.contains('active'))?.dataset.category ?? 'all';

  const getCategoryLabel = (categoryId: string) => {
    const button = buttons.find((item) => item.dataset.category === categoryId);
    return button?.querySelector('span')?.textContent?.trim() ?? categoryId;
  };

  const updateResults = () => {
    const rawQuery = search?.value.trim() ?? '';
    const query = rawQuery.toLowerCase();
    const matchesByCategory = new Map<string, number>();
    let visible = 0;

    cards.forEach((card) => {
      const categoryId = card.dataset.category ?? '';
      const matchesSearch = !query || Boolean(card.dataset.search?.includes(query));

      if (query && matchesSearch && categoryId) {
        matchesByCategory.set(categoryId, (matchesByCategory.get(categoryId) ?? 0) + 1);
      }

      const matchesCategory = selectedCategory === 'all' || categoryId === selectedCategory;
      const show = Boolean(matchesCategory && matchesSearch);
      card.hidden = !show;
      if (show) visible += 1;
    });

    let visibleMatchCards = 0;

    matchCards.forEach((card) => {
      const categoryId = card.dataset.categoryMatchCard ?? '';
      const matches = matchesByCategory.get(categoryId) ?? 0;
      const show = Boolean(
        query &&
        selectedCategory !== 'all' &&
        categoryId !== selectedCategory &&
        matches > 0
      );

      card.hidden = !show;
      if (!show) return;

      visibleMatchCards += 1;
      const label = card.dataset.categoryLabel ?? getCategoryLabel(categoryId);
      const matchTitle = card.querySelector<HTMLElement>('[data-category-match-title]');
      const matchDescription = card.querySelector<HTMLElement>('[data-category-match-description]');

      if (matchTitle) {
        matchTitle.textContent = `${matches} ${matches === 1 ? 'match' : 'matches'} in ${label}`;
      }
      if (matchDescription) {
        matchDescription.textContent = `Show ${label} results for “${rawQuery}”.`;
      }
      card.setAttribute('aria-label', `Show ${matches} ${matches === 1 ? 'match' : 'matches'} in ${label} for ${rawQuery}`);
    });

    if (count) count.textContent = `${visible} ${visible === 1 ? 'item' : 'items'}`;
    if (noResults) noResults.hidden = visible !== 0 || visibleMatchCards !== 0;
  };

  const selectCategory = (categoryId: string) => {
    selectedCategory = categoryId;

    buttons.forEach((button) => {
      const active = button.dataset.category === categoryId;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', active.toString());
    });

    if (title) title.textContent = getCategoryLabel(categoryId);
    updateResults();
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      selectCategory(button.dataset.category ?? 'all');
    });
  });

  matchCards.forEach((card) => {
    card.addEventListener('click', () => {
      const categoryId = card.dataset.categoryMatchCard;
      if (categoryId) selectCategory(categoryId);
    });
  });

  search?.addEventListener('input', updateResults);
  search?.addEventListener('search', updateResults);
  updateResults();
</script>

<style>
  .feature-hero {
    padding: clamp(82px, 11vw, 142px) 0 clamp(70px, 9vw, 112px);
    text-align: center;
    background: #f8fbff;
  }
  .feature-hero h1 {
    max-width: 960px;
    margin: 0 auto 24px;
    color: #08090b;
    font-size: clamp(3.4rem, 7.7vw, 7rem);
    line-height: .95;
  }
  .feature-hero p {
    max-width: 650px;
    margin: 0 auto;
    color: #53565a;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }
  .feature-browser { padding: 72px 24px 120px; color: #f5f5f7; background: #242526; }
  .browser-shell {
    display: grid;
    grid-template-columns: minmax(250px, 1fr) minmax(0, 2fr);
    gap: clamp(34px, 5vw, 72px);
    width: min(1240px, 100%);
    margin-inline: auto;
  }
  .feature-sidebar { position: sticky; top: 104px; align-self: start; }
  .search-field {
    display: flex;
    height: 52px;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    border: 1px solid #4b4c4f;
    border-radius: 14px;
    background: #2d2e30;
  }
  .search-field:focus-within { border-color: #8e9095; box-shadow: 0 0 0 3px rgba(255, 255, 255, .08); }
  .search-field svg { width: 20px; fill: none; stroke: #aeb0b4; stroke-linecap: round; stroke-width: 1.7; }
  .search-field input { width: 100%; border: 0; outline: 0; color: white; background: transparent; }
  .search-field input::placeholder { color: #94969b; }
  .category-list { display: grid; gap: 10px; margin-top: 18px; }
  .category-button {
    display: flex;
    width: 100%;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: 13px;
    color: #f5f5f7;
    background: #2d2e30;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }
  .category-button.red { background: rgba(140, 52, 52, .27); }
  .category-button.yellow { background: rgba(139, 112, 34, .27); }
  .category-button.green { background: rgba(42, 122, 70, .27); }
  .category-button:hover, .category-button.active { border-color: #797b80; }
  .category-button.active { box-shadow: inset 3px 0 #f5f5f7; }
  .category-counts { display: flex; flex-shrink: 0; gap: 8px; font-size: .75rem; font-weight: 600; }
  .category-total { color: #aeb0b4; font-size: .8rem; }
  .results-heading { display: flex; min-height: 52px; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 18px; }
  .results-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); }
  .results-heading span { color: #aeb0b4; font-size: .84rem; }
  .feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .feature-card {
    display: flex;
    min-height: 224px;
    flex-direction: column;
    padding: 25px;
    border: 1px solid #454649;
    border-radius: 20px;
    background: #2d2e30;
  }
  .feature-card[hidden] { display: none; }
  .feature-card.implemented { border-top-color: rgba(94, 190, 124, .8); }
  .feature-card.unimplemented { border-top-color: rgba(223, 102, 102, .8); }
  .card-heading { display: grid; grid-template-columns: 1fr auto; gap: 18px; align-items: start; }
  .card-heading h3 { margin: 0; font-size: 1.25rem; letter-spacing: -.025em; }
  .feature-status { font-size: 1rem; }
  .feature-card p { margin: 18px 0 30px; color: #b7b8bc; font-size: .93rem; line-height: 1.55; }
  .category-label { margin-top: auto; color: #888a8f; font: 650 .68rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .category-match-card {
    appearance: none;
    width: 100%;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .category-match-card:hover { border-color: #797b80; }
  .category-match-card:focus-visible {
    outline: 2px solid #f5f5f7;
    outline-offset: 3px;
  }
  .no-results { padding: 64px 24px; border: 1px dashed #55575b; border-radius: 20px; color: #b7b8bc; text-align: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 820px) {
    .browser-shell { grid-template-columns: 1fr; }
    .feature-sidebar { position: static; }
    .category-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .feature-browser { padding-inline: 15px; }
    .category-list, .feature-grid { grid-template-columns: 1fr; }
    .feature-card { min-height: 200px; }
  }
</style>
