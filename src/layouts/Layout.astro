---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'cppMax, C++ on iPhone and iPad',
  description = 'Write, compile, and run C++ on your iPhone or iPad. The cppMax beta works on-device and keeps your projects local.',
} = Astro.props;

const nav = [
  { href: '/features/', label: 'What works' },
  { href: '/how-it-works/', label: 'How it runs' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/docs/', label: 'Docs' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1e9" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2218%22 fill=%22%23244cff%22/><text x=%2215%22 y=%2267%22 fill=%22white%22 font-size=%2250%22 font-family=%22monospace%22>C+</text></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="cppMax home"><span class="mark">C+</span><span>cppMax</span></a>
        <nav aria-label="Main navigation">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
        <a class="beta-link" href="/support/#beta-access">Get the beta <span>↗</span></a>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="shell footer-top">
        <div class="footer-statement"><a class="brand" href="/"><span class="mark">C+</span><span>cppMax</span></a><p>Build C++ programs on the device you already carry.</p></div>
        <div><strong>Product</strong><a href="/features/">What works</a><a href="/how-it-works/">How it runs</a><a href="/pricing/">Pricing</a><a href="/docs/">Docs</a></div>
        <div><strong>Help</strong><a href="/faq/">FAQ</a><a href="/support/">Support</a></div>
        <div><strong>Fine print</strong><a href="/privacy/">Privacy</a><a href="/legal/">Legal</a></div>
      </div>
      <div class="shell footer-bottom"><span>cppMax beta</span><span>iPhone and iPad</span><span>© {new Date().getFullYear()}</span></div>
    </footer>
  </body>
</html>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--line); background: rgba(244,241,233,.9); backdrop-filter: blur(14px); }
  .header-inner { display: flex; min-height: 72px; align-items: center; gap: 34px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 1.1rem; font-weight: 800; letter-spacing: -.04em; text-decoration: none; }
  .mark { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 5px; color: white; background: var(--blue); font: 800 .8rem/1 ui-monospace, monospace; }
  nav { display: flex; align-items: center; gap: 28px; margin-left: auto; }
  nav a { color: #4f4f49; font-size: .88rem; font-weight: 700; text-decoration: none; }
  nav a:hover { color: var(--blue); }
  .beta-link { display: inline-flex; gap: 8px; padding: 10px 0 10px 16px; border-left: 1px solid var(--line); color: var(--blue); font-size: .88rem; font-weight: 800; text-decoration: none; }
  footer { padding: 72px 0 26px; border-top: 1px solid var(--line); }
  .footer-top { display: grid; grid-template-columns: 2.2fr repeat(3, 1fr); gap: 44px; }
  .footer-statement p { max-width: 360px; margin: 25px 0 0; font-size: 1.25rem; }
  .footer-top > div:not(:first-child) { display: flex; align-items: flex-start; flex-direction: column; gap: 12px; }
  .footer-top strong { margin-bottom: 6px; font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; }
  .footer-top a:not(.brand) { color: var(--muted); font-size: .88rem; text-decoration: none; }
  .footer-top a:hover { color: var(--blue); }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: 64px; padding-top: 20px; border-top: 1px solid var(--line); color: #77766f; font: 650 .67rem/1 ui-monospace, monospace; text-transform: uppercase; }
  @media (max-width: 800px) { nav { display: none; } .beta-link { margin-left: auto; } .footer-top { grid-template-columns: 1fr 1fr; } .footer-statement { grid-column: 1 / -1; } }
  @media (max-width: 430px) { .beta-link { font-size: .78rem; } .footer-top { grid-template-columns: 1fr; } .footer-statement { grid-column: auto; } }
</style>
